// ForestRegenMod config (JSONC). Comments are allowed.
// Tree species codes for TreeSpeciesBlacklist: acacia, ash, beech, birch, baldcypress, crimsonkingmaple, ebony, kapok, larch, maple, oak, pine, purpleheart, redwood, walnut
{
  // Enable or disable the mod entirely.
  "Enabled": true,
  // Regeneration attempts earned per in-game hour since the last time this chunk was processed by the mod.
  "AttemptsPerInGameHour": 0.003,
  // Hard cap on calculated attempts per chunk load.
  "MaxAttemptsPerChunkLoad": 8,
  // Hard cap on successful sapling placements per chunk load.
  "MaxSuccessfulPlacementsPerChunkLoad": 4,
  // Minimum ForestMap density required to allow recovery at a position.
  "MinForestMapDensityForRegen": 0.1,
  // Radius used for deterministic local forest density checks.
  "LocalDensityRadius": 16,
  // Grid step in blocks for deterministic local density checks.
  "LocalDensityGridStep": 4,
  // Use a circular mask instead of a square mask for local density checks.
  "LocalDensityUseCircularMask": true,
  // Local density may not exceed ForestMap density multiplied by this value.
  "ForestMapDensityMaxMultiplier": 1.5,
  // Hard minimum spacing from nearby trees, saplings and leaves.
  "MinimumTreeSpacingRadius": 4,
  // Hard minimum spacing from blocks listed in NoPlantNearBlockPathContains.
  "NoPlantNearBlockSpacingRadius": 4,
  // Block path fragments that prevent sapling placement inside the spacing cube.
  "NoPlantNearBlockPathContains": ["road", "path", "packed"],
  // Strict candidate search tries per placement.
  "CandidateSearchAttemptsPerPlacement": 24,
  // Extra relaxed search tries if relaxed fallback is enabled.
  "RelaxedCandidateSearchAttemptsPerPlacement": 8,
  // Minimum distance from online players.
  "PlayerExclusionRadius": 8,
  // Radius for scanning nearby existing tree species. This is the per-site scan radius.
  "SpeciesSearchRadius": 16,
  // Number of probe points used by the nearby species scan.
  "SpeciesSearchSamples": 32,
  // Radius for building the chunk's allowed forest species cache.
  "ChunkSpeciesSearchRadius": 32,
  // Number of probes for building the chunk species cache.
  "ChunkSpeciesSearchSamples": 128,
  // Require positive fertility on the soil block.
  "RequireFertileGround": true,
  // Allow a looser placement search if strict search found nothing.
  "AllowRelaxedPlacementFallback": false,
  // Half-life for diminishing returns on very long inactivity.
  "DiminishingReturnsHalfLifeHours": 480,
  // Restrict species selection to species observed in the original local forest.
  "RestrictToObservedForestSpecies": true,
  // Require stored or nearby observed species, otherwise skip planting.
  "RequireStoredOrNearbySpecies": true,
  // Restrict planting to natural forest soils only.
  "RequireNaturalForestSoil": true,
  // Never plant inside land claims / private protected areas.
  "BlockPlantingInsideClaims": true,
  // Blacklist of tree species codes that this mod must never plant.
  "TreeSpeciesBlacklist": ["ebony", "purpleheart", "crimsonkingmaple"],
  // Skip regeneration when the mod sees a chunk for the first time. Usually false for existing worlds.
  "SkipFirstSeenChunk": false,
  // Use synthetic historical time for first-seen chunks when no good timestamp exists.
  "UseSyntheticBackfillOnFirstSeen": true,
  // Synthetic backfill hours for first-seen chunks.
  "FirstSeenBackfillHours": 720,
  // Maximum allowed first-seen synthetic backfill.
  "MaxFirstSeenBackfillHours": 1440,
  // Maximum number of queued chunk scan jobs processed per server tick.
  "MaxQueuedChunkJobsPerTick": 2,
  // Maximum number of queued placement jobs processed per server tick.
  "MaxQueuedPlacementsPerTick": 2,
  // Maximum number of scan work units processed per server tick.
  "ScanWorkBudgetPerTick": 4,
  // Maximum number of placement work units processed per server tick.
  "PlacementWorkBudgetPerTick": 2
}
